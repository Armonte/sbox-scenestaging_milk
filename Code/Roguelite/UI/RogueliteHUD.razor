@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<root class="roguelite-hud">

    @* Crosshair *@
    <div class="crosshair">+</div>

    @* Health Bar *@
    <div class="health-section">
        <div class="health-bar">
            <div class="health-fill" style="width: @GetHealthPercent()%"></div>
        </div>
        <div class="health-text">@GetHealthText()</div>
    </div>

    @* Weapon info *@
    <div class="weapon-section">
        <div class="weapon-name">@GetWeaponName()</div>

        @* Combo indicator (sword) *@
        @if (GetComboStep() > 0)
        {
            <div class="combo-indicator">
                <span class="combo-count">@GetComboStep()</span>
                <span class="combo-label">HIT</span>
            </div>
        }

        @* Draw bar (bow) *@
        @if (GetDrawProgress() > 0)
        {
            <div class="draw-bar">
                <div class="draw-fill @(IsSweetspot() ? "sweetspot" : "")" style="width: @(GetDrawProgress() * 100f)%"></div>
            </div>
        }
    </div>

    @* Speed counter *@
    <div class="speed-counter">@GetSpeed() u/s</div>

    @* Damage flash *@
    @if (ShowDamageFlash())
    {
        <div class="damage-flash"></div>
    }

</root>

@code {

    private float _lastHealth = -1f;
    private TimeSince _timeSinceDamage = 10f;
    private bool _showFlash;

    RoguelitePlayer GetPlayer()
    {
        return Scene?.GetAllComponents<RoguelitePlayer>()
            ?.Where( p => !p.IsProxy )
            ?.FirstOrDefault();
    }

    string GetHealthText()
    {
        var player = GetPlayer();
        if ( player is null ) return "0 / 0";
        return $"{player.HealthCurrent:F0} / {player.HealthMax:F0}";
    }

    float GetHealthPercent()
    {
        var player = GetPlayer();
        if ( player is null || player.HealthMax <= 0 ) return 0;
        return Math.Clamp( (player.HealthCurrent / player.HealthMax) * 100f, 0f, 100f );
    }

    int GetComboStep()
    {
        var player = GetPlayer();
        if ( player is null ) return 0;
        var sword = player.ActiveWeapon as SwordWeapon;
        return sword?.CurrentComboStep ?? 0;
    }

    string GetWeaponName()
    {
        var player = GetPlayer();
        if ( player?.ActiveWeapon is null ) return "No Weapon";
        return player.ActiveWeapon.Category.ToString();
    }

    float GetDrawProgress()
    {
        var player = GetPlayer();
        if ( player is null ) return 0;
        var bow = player.ActiveWeapon as BowWeapon;
        return bow?.DrawProgress ?? 0;
    }

    bool IsSweetspot()
    {
        var player = GetPlayer();
        if ( player is null ) return false;
        var bow = player.ActiveWeapon as BowWeapon;
        return bow?.IsSweetspot ?? false;
    }

    string GetSpeed()
    {
        var player = GetPlayer();
        if ( player is null ) return "0";
        var cc = player.Components.Get<CharacterController>();
        if ( cc is null ) return "0";
        return cc.Velocity.WithZ( 0 ).Length.ToString( "F0" );
    }

    bool ShowDamageFlash() => _showFlash;

    protected override void OnUpdate()
    {
        var player = GetPlayer();
        if ( player is null ) return;

        if ( _lastHealth >= 0 && player.HealthCurrent < _lastHealth )
            _timeSinceDamage = 0;

        _lastHealth = player.HealthCurrent;
        _showFlash = _timeSinceDamage < 0.3f;
    }

    protected override int BuildHash()
    {
        var player = GetPlayer();
        if ( player is null ) return 0;
        return HashCode.Combine( player.HealthCurrent, player.HealthMax, player.IsAlive, GetComboStep(), _showFlash, GetSpeed(), GetDrawProgress(), GetWeaponName() );
    }
}
